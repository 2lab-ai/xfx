+    fn old_a_fetch_runs_on_its_own_thread_and_can_be_cancelled_mid_body() {
+        let stop = Arc::new(AtomicBool::new(false));
+        let (origin, _drips, server) = dripping(&stop);
+        let slot = Slot::default();
+        let spawned = Arc::new(AtomicUsize::new(0));
+        let counting = Arc::clone(&spawned);
+        let spawn = keeping(&slot);
+        let asked = question_at(&origin);
+        let started = Instant::now();
+        let mut fetch = Fetch::start(asked, vec![today()], move |job| {
+            counting.fetch_add(1, Ordering::SeqCst);
+            spawn(job)
+        })
+        .expect("a worker");
+        assert_eq!(spawned.load(Ordering::SeqCst), 1);
+        assert_eq!(
+            fetch.try_outcome(),
