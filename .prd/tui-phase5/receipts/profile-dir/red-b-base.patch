+}
+
+pub(super) fn before_stage(profile: &Path) {
+    if let Some(hand) = BEFORE_STAGE.with(std::cell::Cell::get) {
+        hand(profile);
+    }
+}
+
+#[cfg(unix)]
+#[test]
+fn red_b_a_profile_home_gone_before_the_stage_is_made_is_not_made_again() {
+    let bench = bench();
+    let (recorder, source) = rich(&bench);
+    drop(recorder);
+    let profile = bench.store.profile_dir().to_path_buf();
+    BEFORE_STAGE.with(|cell| cell.set(Some(|p| fs::remove_dir_all(p).expect("taken away"))));
+    let result = bench.fork(&source, 3);
+    BEFORE_STAGE.with(|cell| cell.set(None));
+    let remade = fs::symlink_metadata(&profile)
+        .map(|m| format!("remade {:o}", m.permissions().mode() & 0o777))
+        .unwrap_or_else(|_| "not remade".to_string());
+    println!("RED fork with ~/.xfx removed before its stage: {} ; ~/.xfx {remade}",
+        match &result { Ok(_) => "the fork succeeded".to_string(), Err(e) => format!("refused: {e}") });
+    assert!(fs::symlink_metadata(&profile).is_err(), "the fork made the profile home again");
 }
 
