     static BEFORE_RULES: std::cell::Cell<Option<fn(&Path)>> = const { std::cell::Cell::new(None) };
     static STAGE_SEEN: std::cell::RefCell<Option<PathBuf>> = const { std::cell::RefCell::new(None) };
