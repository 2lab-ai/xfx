# /mcp with no servers anywhere.
wait 3
type /mcp
key Enter
wait 1.5
snap menu
key Down
wait 0.5
snap menu-down
key Right
wait 0.7
snap menu-tools
key Escape
wait 0.5
snap menu-esc
key C-u
type /mcp list
key Enter
wait 1.5
snap list
key Escape
wait 0.3
key C-u
type /mcp path
key Enter
wait 1
snap path
type /mcp reload
key Enter
wait 2
snap reload
type /mcp auth
key Enter
wait 1
snap auth-bare
type /mcp auth nope
key Enter
wait 1
snap auth-nope
type /mcp logout nope
key Enter
wait 1
snap logout-nope
type /mcp remove nope
key Enter
wait 1
snap remove-nope
type /mcp add
key Enter
wait 1
snap add-bare
type /mcp resource list nope
key Enter
wait 1
snap resource-nope
type /mcp prompt
key Enter
wait 1
snap prompt-bare
type /mcp trust
key Enter
wait 1
snap trust-bare
type /mcp bogus
key Enter
wait 1
snap bogus
