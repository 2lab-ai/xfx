# p5 mcp: a profile with one entry fx can't read -- the menu's config-note
# row, the status line, and /mcp list's notes.
# The stdio server is p5-mcp-stdio.ts, which the profile names by `@BUN@` and
# `@SCENARIOS@` (capture.sh writes both in), and xfx is given the same profile.
fx: homefile .fx/mcp.json p5-mcp-notes-profile.json
xfx: homefile .xfx/mcp.json p5-mcp-notes-profile.json
keep
wait 12
# The status line keeps its MCP text back while a server is still
# starting, up to 10 s (statusline.rs MCP_STARTUP_QUIET,
# menu.zig:443@481104fd). The snap is the config's problem once it is
# said, not a second count 2 s past the 10 (FLAKE-HINT4).
until shown MCP config has 1 problem
snap startup
type /mcp
key Enter
wait 2
snap menu
key Escape
wait 0.5
key C-u
type /mcp list
key Enter
wait 2
snap list
key Escape
wait 0.3
key C-u
snapfull end
