# Phase 5 T-U1/T-U2 across a width change: p5-transcript-anchormid's view, a
# page up mid-document while the command runs, then the window narrowed to 80
# columns with Ctrl-O still up (every entry is laid out again, the wrapped
# heading takes more rows) and widened back; then the command settles under
# the narrow-then-wide view. fx re-selects its bookmark on a width change
# (`prepare_projection`, transcript_presentation.zig:115-122@481104fd).
# fx's `shell`/`run` is xfx's `terminal`/`exec`; TZ=UTC on both (T-U5).
fx: gateway p5-transcript-anchor-turns.json
xfx: gateway p5-transcript-anchor-xfx.json
fx: env FX_AUTO_UPGRADE=0
fx: env FX_PERMISSION_MODE=yolo
xfx: env XFX_PERMISSION_MODE=yolo
env TZ=UTC
work p5-transcript-ws
wait 4
type read and wait
wait 1
key Enter
wait 4
key C-o
wait 2
snap full-running
key PPage
wait 1
snap full-pgup
resize 40x80
wait 1.5
snap full-pgup-80
key C-o
wait 0.5
key C-o
wait 1.5
snap full-tail-80
resize 40x120
wait 1.5
snap full-tail-120
key PPage
wait 1
snap full-pgup-120
wait 9
snap full-pgup-after
key C-o
wait 1
gwlog
