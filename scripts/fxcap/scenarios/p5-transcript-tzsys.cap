# Phase 5 transcript (T-U5): Ctrl-O entry times read the local zone
# (v0.0.16's c9bc4876; UTC on c1db919). No TZ: the system zone, read from
# /etc/localtime (Asia/Seoul, KST, on the capture machine).
# `xfx: env XFX_PERMISSION_MODE=yolo` matches fx's mode row (added by T-U5).
gateway p5-transcript-tz-turns.json
fx: env FX_AUTO_UPGRADE=0
fx: env FX_PERMISSION_MODE=yolo
xfx: env XFX_PERMISSION_MODE=yolo
# no TZ: the system zone (Asia/Seoul here)
work p5-transcript-ws
wait 4
type read it
wait 1
key Enter
wait 4
key C-o
wait 2
snap full
key C-o
wait 1
