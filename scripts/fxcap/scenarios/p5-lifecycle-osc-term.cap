# Phase 5 L-U2: SIGTERM after a finished turn. The handler's abnormal restore
# -- one write(2) of a constant -- clears the record, and nothing follows it.
gateway p5-lifecycle-one-turn.json
xfx: env XFX_SOUND=off
keep
wait 4
type first question
key Enter
wait 3
wire t00-done
signal TERM
wait 1
wire t01-terminated
