# P5 U3-TC: p5-inline-code-table in a session that claims truecolor, as
# p5-inline-code-retint-tc: a table keeps the colours it was drawn in at
# either depth (store.zig:3758@481104fd), while the prose beside it follows.
gateway p5-inline-code-table-turns.json
fx: env FX_AUTO_UPGRADE=0
env COLORTERM=truecolor
wait 4
type show me the table
wait 1
key Enter
wait 8
snap dark
key -H 1b 5b 3f 39 39 37 3b 32 6e
wait 2
snap light
key -H 1b 5b 3f 39 39 37 3b 31 6e
wait 2
snap dark-again
