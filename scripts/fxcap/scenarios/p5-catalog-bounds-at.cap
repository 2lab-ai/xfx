# CATALOG-BOUNDS: the Gateway catalog answers 16777216 bytes, exactly fx's
# 16 MiB (`max_gateway_json_bytes`, src/gateway/client.zig:611-635), padded
# before the catalog, so a read cut short of it is no catalog: fx reads it
# whole, and `/model` lists its rows.
fx: env FX_AUTO_UPGRADE=0
models p5-input-models.json
modelspad 16777216 head
wait 4
type /model
key Enter
wait 3
snap menu
gwlog
