# Phase 5 panels: `/status` with no credential and a profile settings file
# that cannot be read: the panel says so in a Settings row and drops Auth
# (fx 8a964aca); the old notice was an error and no status.
fx: env FX_AUTO_UPGRADE=0
env AI_GATEWAY_API_KEY=
seed p5-panels-badsettings.json
wait 3
snap launch
type /status
key Enter
wait 1.5
snap open
key Escape
wait 0.5
