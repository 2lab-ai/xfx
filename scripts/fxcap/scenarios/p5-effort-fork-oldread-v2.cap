fx: env FX_AUTO_UPGRADE=0 FX_SESSIONS_V2=1
# The same store, read by an fx on its v2 store (FX_SESSIONS_V2=1 there; the
# only store in v0.0.16): its picker, the fork resumed, a turn added to it.
gateway p5-effort-fork-turns.json
homefile .fx/sessions/v2/index.jsonl p5-effort-fork-v2-index.jsonl
homefile .fx/sessions/v2/kH1xJ5Cm-oRk/log.jsonl p5-effort-fork-v2-source.jsonl
homefile .fx/sessions/v2/HU7p6L-En72Q/log.jsonl p5-effort-fork-v2-fork.jsonl
wait 3
snap launch
type /resume
key Enter
wait 2
snap picker
key Tab
wait 1
snap picker-all
key Escape
wait 0.5
keep
type /quit
key Enter
wait 2
relaunch --resume HU7p6L-En72Q
wait 4
snap resume-id
snapfull resume-id
type one more on the fork
key Enter
wait 3
snap continued
type /quit
key Enter
wait 2
snap quit
home end
