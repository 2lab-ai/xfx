# Phase 5 panels, part 2: every slash command not owned by another
# cluster, once each from a fresh launch, so its screen can be set beside
# the c1db919 one. Menus are snapped open, then closed with Escape.
fx: env FX_AUTO_UPGRADE=0
wait 2
type /version
wait 0.3
key Enter
wait 1.5
snap version
type /stats
wait 0.3
key Enter
wait 1.5
snap stats
type /copy
wait 0.3
key Enter
wait 1.5
snap copy
type /undo
wait 0.3
key Enter
wait 1.5
snap undo
type /images
wait 0.3
key Enter
wait 1.5
snap images
type /image nofile.png
wait 0.3
key Enter
wait 1.5
snap image-missing
type /fast
wait 0.3
key Enter
wait 1.5
snap fast
type /ultrafast status
wait 0.3
key Enter
wait 1.5
snap ultrafast
type /credits
wait 0.3
key Enter
wait 1.5
snap credits
type /alias
wait 0.3
key Enter
wait 1.5
snap alias
type /shell reload
wait 0.3
key Enter
wait 1.5
snap shell
type /rename My title
wait 0.3
key Enter
wait 1.5
snap rename
type /allowlist
wait 0.3
key Enter
wait 1.5
snap allowlist
type /compact
wait 0.3
key Enter
# /compact with nothing to compact answers "No context to compact." for
# 1.5 s (compaction.rs TRANSIENT, compaction_activity.zig:123@481104fd):
# the snap is that answer, taken while it is up, not 1.5 s after Enter,
# the moment it goes (FLAKE-HINT4).
until shown No context to compact.
snap compact-empty
type /trace
wait 0.3
key Enter
wait 1.5
snap trace
type /feedback
wait 0.3
key Enter
wait 1.5
snap feedback
type /logout
wait 0.3
key Enter
wait 1.5
snap logout
type /settings
wait 0.3
key Enter
wait 1.5
snap settings
key Escape
wait 0.5
key C-u
wait 0.3
snap settings-closed
type /statusline
wait 0.3
key Enter
wait 1.5
snap statusline
key Escape
wait 0.5
key C-u
wait 0.3
snap statusline-closed
type /workspace
wait 0.3
key Enter
wait 1.5
snap workspace
key Escape
wait 0.5
key C-u
wait 0.3
snap workspace-closed
type /resume
wait 0.3
key Enter
wait 1.5
snap resume
key Escape
wait 0.5
key C-u
wait 0.3
snap resume-closed
type /login
wait 0.3
key Enter
wait 1.5
snap login
key Escape
wait 0.5
key C-u
wait 0.3
snap login-closed
type /provider
wait 0.3
key Enter
wait 1.5
snap provider
key Escape
wait 0.5
key C-u
wait 0.3
snap provider-closed
type /new
wait 0.3
key Enter
wait 1.5
snap new
type /reset
wait 0.3
key Enter
wait 1.5
snap reset
type /clear
wait 0.3
key Enter
wait 1.5
snap clear
keep
type /quit
key Enter
wait 2
snap quit
