# Phase 5 input cluster: a catalog that fails at launch (14a12fea's retry
# sentence) and is back later (f4990675 refresh on activity).
fx: env FX_AUTO_UPGRADE=0
models p5-input-models.json
modelsdown 15000
wait 4
type /model
key Enter
wait 2
snap fail-open
key Escape
wait 0.5
wait 14
type /model
key Enter
wait 3
snap after-outage
