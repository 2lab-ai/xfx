fx: env FX_AUTO_UPGRADE=0
# /effort (fx 04a5e3af): the bare menu, its keys, Enter and Escape, the
# announcement; /effort <level> applied, malformed, unavailable, default;
# the `/effort ` column (Space and Tab), its preview, filter and fill; a
# change mid-turn; and which request carried which reasoning.
models p5-effort-fork-models.json
gateway p5-effort-fork-slow-turns.json
seed p5-effort-fork-seed-astra.json
nomodel
wait 3
snap launch
type /ef
wait 0.6
snap slash-ef
key C-u
wait 0.3
type /effort
wait 0.3
key Enter
wait 1
snap menu
key Down
wait 0.3
snap menu-down
key Up Up
wait 0.3
snap menu-wrap
key Escape
wait 0.5
snap menu-esc
type /effort
key Enter
wait 1
key Down Down
wait 0.3
key Enter
wait 1
snap menu-enter
home after-menu-enter
paste /effort high
wait 0.4
key Enter
wait 1
snap level-high
paste /effort bogus
wait 0.4
key Enter
wait 1
snap level-bogus
paste /effort max
wait 0.4
key Enter
wait 1
snap level-max
paste /effort HIGH
wait 0.4
key Enter
wait 1
snap level-upper
paste /effort two words
wait 0.4
key Enter
wait 1
snap level-malformed
paste /effort default
wait 0.4
key Enter
wait 1
snap level-default
home after-default
type /effort
key Space
wait 0.8
snap col-space
key Down
wait 0.4
snap col-down
type zz
wait 0.4
snap col-nomatch
key C-u
wait 0.3
type /effort
key Tab
wait 0.8
snap col-tab
key Down
wait 0.3
key Tab
wait 0.5
snap col-fill
key Enter
wait 1
snap col-enter
home after-col
type slow turn please
key Enter
wait 1.5
paste /effort high
wait 0.4
key Enter
wait 1
snap midturn
wait 8
snap midturn-done
type after the change
key Enter
wait 3
snap after-turn
home end
gwlog
