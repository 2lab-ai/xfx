# Phase 5 panels: the `/help` catalog with v0.0.16's registry (/fork,
# /effort, /status's new summary): All, then each tab, then queries.
fx: env FX_AUTO_UPGRADE=0
wait 2
type /help
key Enter
wait 1
snap open
key Tab
wait 0.4
snap tab-general
key Tab
wait 0.4
snap tab-session
key Tab
wait 0.4
snap tab-account
key Tab
wait 0.4
snap tab-model
key Tab
wait 0.4
snap tab-appearance
key Tab
wait 0.4
snap tab-security
key Tab
wait 0.4
snap tab-workspace
key Tab
wait 0.4
snap tab-media
key Tab
wait 0.4
snap tab-agents
key Tab
wait 0.4
snap tab-extensions
key Tab
wait 0.4
snap tab-product
key Tab
wait 0.4
snap tab-wrap
type status
wait 0.5
snap query-status
key C-u
type alias
wait 0.5
snap query-alias
key C-u
type cost
wait 0.5
snap query-cost
key Escape
wait 0.5
snap esc
