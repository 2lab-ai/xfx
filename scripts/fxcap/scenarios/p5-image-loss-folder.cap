# IMAGE-LOSS-COPY-FX round 3: p5-image-loss-whole with the folder the image's
# copy is in made unreadable before the resume. fx opens the blob folder for
# reading and `stat`s the blob in it; a failure other than NotFound is `Io`,
# handed up unchanged, and the launch prints its name (`blobExists`,
# `notFoundOr`, session.zig:1666-1681@481104fd; `imageBlobFailed`,
# session_adapter.zig:2881-2893; formatUnexpectedError,
# app_entry_runtime.zig:537-539). The folder is set back before `home after`.
fx: env FX_AUTO_UPGRADE=0 FX_SESSIONS_V2=1
fx: homefile .fx/sessions/v2/index.jsonl p5-effort-fork-v2-index.jsonl
fx: homefile .fx/sessions/v2/index.lock p5-lifecycle-v1-plain-session.lock
fx: homefile .fx/sessions/v2/kH1xJ5Cm-oRk/log.jsonl p5-image-loss-gone-fx.jsonl
fx: homefile .fx/sessions/v2/kH1xJ5Cm-oRk/lock p5-lifecycle-v1-plain-session.lock
xfx: homefile .xfx/sessions/kH1xJ5Cm-oRk/events.jsonl p5-image-loss-gone-xfx-events.jsonl
xfx: homefile .xfx/sessions/kH1xJ5Cm-oRk/session.json p5-image-loss-gone-xfx-session.json
fx: homefile .fx/sessions/v2/kH1xJ5Cm-oRk/blobs/3fd6e6be528c182d768563a63b65ac5a70d022149a01eeeaaa30396d75f426e0 image-ws/shot.png
xfx: homefile .xfx/sessions/kH1xJ5Cm-oRk/images/image-1-3fd6e6be528c182d.bin image-ws/shot.png
models models-image.json
gateway image-turns.json
wait 3
keep
type /quit
key Enter
wait 2
fx: homemode 000 .fx/sessions/v2/kH1xJ5Cm-oRk/blobs
xfx: homemode 000 .xfx/sessions/kH1xJ5Cm-oRk/images
relaunch --resume kH1xJ5Cm-oRk
wait 4
snapfull refused
fx: homemode 700 .fx/sessions/v2/kH1xJ5Cm-oRk/blobs
xfx: homemode 700 .xfx/sessions/kH1xJ5Cm-oRk/images
home after
