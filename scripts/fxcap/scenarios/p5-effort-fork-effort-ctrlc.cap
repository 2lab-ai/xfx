fx: env FX_AUTO_UPGRADE=0
# A first Ctrl-C over the /effort menu: the menu stays, and its key help gives
# way to `press ctrl+c again to exit` (`composeEffortMenuHintRow`'s
# `ctrl_c_pending`, `input_presentation.zig:671-679@481104fd`).
models p5-effort-fork-models.json
seed p5-effort-fork-seed-astra.json
nomodel
wait 3
type /effort
key Enter
wait 1
key C-c
# The hint is up for 3 s (capfile.py TIMERS): both snaps are taken while it
# is, from when it came, and `ctrlc-later` 1.8 s in rather than 2.8 s, which
# was 0.2 s from the moment it goes (FLAKE-HINT4).
until shown press ctrl+c again to exit
wait 0.3
snap ctrlc
# The frame itself holds the row it is for, or the run fails: the `until
# shown` before it was a look, and a wait came between (FLAKE-HINT4).
expect ctrlc press ctrl+c again to exit
wait 1.5
snap ctrlc-later
expect ctrlc-later press ctrl+c again to exit
