# IMAGE-LOSS-COPY-FX round 2: p5-image-loss-gone's session with its image's
# copy there, one byte changed. The session reads (fx checks only that the blob
# is a file, blobExists, session.zig:1666-1681@481104fd); the next prompt's
# request fails on the copy's bytes (loadVerifiedSnapshot,
# image_attachments.zig:1260-1320), and `home failed` shows what the failed
# turn left in the log.
fx: env FX_AUTO_UPGRADE=0 FX_SESSIONS_V2=1
fx: homefile .fx/sessions/v2/index.jsonl p5-effort-fork-v2-index.jsonl
fx: homefile .fx/sessions/v2/index.lock p5-lifecycle-v1-plain-session.lock
fx: homefile .fx/sessions/v2/kH1xJ5Cm-oRk/log.jsonl p5-image-loss-gone-fx.jsonl
fx: homefile .fx/sessions/v2/kH1xJ5Cm-oRk/lock p5-lifecycle-v1-plain-session.lock
xfx: homefile .xfx/sessions/kH1xJ5Cm-oRk/events.jsonl p5-image-loss-gone-xfx-events.jsonl
xfx: homefile .xfx/sessions/kH1xJ5Cm-oRk/session.json p5-image-loss-gone-xfx-session.json
fx: homefile .fx/sessions/v2/kH1xJ5Cm-oRk/blobs/3fd6e6be528c182d768563a63b65ac5a70d022149a01eeeaaa30396d75f426e0 p5-image-loss-changed.bin
xfx: homefile .xfx/sessions/kH1xJ5Cm-oRk/images/image-1-3fd6e6be528c182d.bin p5-image-loss-changed.bin
models models-image.json
gateway image-turns.json
wait 3
keep
type /quit
key Enter
wait 2
relaunch --resume kH1xJ5Cm-oRk
wait 4
snap resumed
home resumed
type what is it now?
key Enter
wait 4
snap failed
home failed
