# P5 T-U3-TCc: p5-toolstop-retint drawn light first (COLORFGBG, as
# p5-inline-code-retint-light), then dark and light again.
fx: gateway p5-toolstop-retint-fx.json
xfx: gateway p5-toolstop-retint-xfx.json
fx: env FX_AUTO_UPGRADE=0
fx: env FX_PERMISSION_MODE=yolo
xfx: env XFX_PERMISSION_MODE=yolo
env COLORFGBG='0;15'
wait 3
type run cmd
key Enter
wait 2.5
# A Ctrl-C while the full-access warning is up takes its row and stops its
# 4 s clock (capfile.py TIMERS), so the warning would come back once the
# exit hint goes: Ctrl-C is sent once the warning has gone.
until gone Full access
key C-c
wait 3
# Ctrl-C's exit hint stays 3 s (capfile.py TIMERS): the snap below is the
# screen once it has gone, not a second count against it.
until gone press ctrl+c again to exit
snap light
key -H 1b 5b 3f 39 39 37 3b 31 6e
wait 2
snap dark
key -H 1b 5b 3f 39 39 37 3b 32 6e
wait 2
snap light-again
